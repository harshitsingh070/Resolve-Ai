# ResolveAI — Root .env.example (copy to backend/.env and fill)
# This file IS committed (no secrets). Real .env is gitignored.

# --- Backend (required) ---
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Use any Groq model with structured output (e.g., llama-3.1-8b-instant, llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-20b

# Database — SQLite file next to backend/
DATABASE_URL=sqlite:///./resolveai.db

# Server
PORT=8000
HOST=0.0.0.0

# --- Frontend (optional) ---
# VITE_API_URL=http://localhost:8000
